# Copy this file to terraform.tfvars and fill in the real values.
# NEVER commit terraform.tfvars to version control — it contains sensitive data.

# ─── Cluster provisioning ────────────────────────────────────────────────────
# use_existing_cluster = true
# kubeconfig_path      = "~/.kube/config"
# kubeconfig_context   = "arn:aws:eks:us-east-1:123456789012:cluster/my-eks-cluster"

# ─── Namespace ──────────────────────────────────────────────────────────────
namespace = "car-repair-app"

# ─── Application ────────────────────────────────────────────────────────────
api_image    = "123456789012.dkr.ecr.us-east-1.amazonaws.com/car-repair-app:latest"
api_replicas = 2

# ─── AWS / IRSA / External Secrets ──────────────────────────────────────────
aws_region                           = "us-east-1"
irsa_role_arn                        = "arn:aws:iam::123456789012:role/car-repair-app-irsa-role"
external_secret_refresh_interval     = "1h"
jwt_secret_manager_secret_id         = "car-repair-app/jwt"
postgres_connection_secret_id        = "car-repair-app/postgres"
smtp_settings_secret_id              = "car-repair-app/smtp"

# ─── App settings ───────────────────────────────────────────────────────────
app_base_url = "https://api.car-repair-app.example.com"
jwt_issuer   = "car-repair-auth"
jwt_audience = "car-repair-app"
