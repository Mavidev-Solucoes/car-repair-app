# Copy this file to .env and fill in the values before running docker compose.
# The .env file is gitignored and should never be committed.

# SQL Server SA password (must meet SQL Server complexity requirements)
SA_PASSWORD=YourStrongPassword@2024!

# JWT secret key (minimum 32 characters)
JWT_SECRET_KEY=YourSuperSecretKeyWithAtLeast32Chars!

# SonarQube database name created inside the existing SQL Server container
SONAR_DB_NAME=SonarQubeDb

# SonarQube user token — generated in the SonarQube UI after first login.
# Used when running dotnet-sonarscanner locally (see README for instructions).
SONAR_TOKEN=
