@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="flex min-h-screen items-center justify-center px-6">
    <div class="w-full max-w-sm rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="mb-8">
            <h1 class="text-xl font-semibold text-slate-950">Sign in</h1>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            @await Html.PartialAsync("_Flash", new FlashMessageViewModel { Message = Model.ErrorMessage, IsError = true })
        }

        <form method="post" class="mt-6 space-y-4">
            @Html.AntiForgeryToken()
            <div class="space-y-2">
                <input asp-for="Email" class="block h-11 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-950 outline-none transition focus:border-slate-950" placeholder="Email" />
                <span asp-validation-for="Email" class="text-sm text-rose-600"></span>
            </div>
            <div class="space-y-2">
                <input asp-for="Password" class="block h-11 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-950 outline-none transition focus:border-slate-950" placeholder="Password" />
                <span asp-validation-for="Password" class="text-sm text-rose-600"></span>
            </div>
            <button type="submit" class="inline-flex h-11 w-full items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-semibold text-white transition hover:bg-slate-800">
                Continue
            </button>
        </form>
    </div>
</div>
