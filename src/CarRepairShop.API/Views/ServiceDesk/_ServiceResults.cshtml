@model ServicesPageViewModel

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-slate-500">
            <tr>
                <th class="px-5 py-3 font-medium">Service</th>
                <th class="px-5 py-3 font-medium">Assigned</th>
                <th class="px-5 py-3 font-medium">Status</th>
                <th class="px-5 py-3 font-medium text-right">Quoted</th>
                <th class="px-5 py-3 font-medium text-right">Opened</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
            @if (Model.Services.Count == 0)
            {
                <tr>
                    <td colspan="5" class="px-5 py-14 text-center text-slate-500">No services matched the current filters.</td>
                </tr>
            }
            else
            {
                @foreach (var service in Model.Services)
                {
                    <tr class="hover:bg-slate-50">
                        <td class="px-5 py-4">
                            <a href="/ui/services/@service.Id" class="font-medium text-slate-950">@service.CustomerName</a>
                            <div class="mt-1 text-slate-600">@service.VehicleLabel</div>
                            <div class="mt-1 text-xs uppercase tracking-[0.12em] text-slate-400">@service.LicensePlate</div>
                        </td>
                        <td class="px-5 py-4 text-slate-700">@service.AssignedEmployee</td>
                        <td class="px-5 py-4">
                            @await Html.PartialAsync("_StatusBadge", service.Status)
                        </td>
                        <td class="px-5 py-4 text-right text-slate-900">@service.GrandTotal.ToString("C")</td>
                        <td class="px-5 py-4 text-right text-slate-500">@service.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
