@model ServicesPageViewModel

@{
    ViewData["Title"] = "Services";
}

<div class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
    <div class="mb-8 flex items-start justify-between gap-6">
        <div>
            <h1 class="text-2xl font-semibold text-slate-950">Services</h1>
            <p class="mt-1 text-sm text-slate-500">Queue, detail, and workflow actions.</p>
        </div>
        @if (Model.CanCreateService)
        {
            <a href="/ui/services/new" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
                New service
            </a>
        }
    </div>

    @if (Model.Flash is not null)
    {
        <div class="mb-6">
            @await Html.PartialAsync("_Flash", Model.Flash)
        </div>
    }

    <form id="service-filters"
          hx-get="/ui/services/results"
          hx-target="#service-results"
          hx-swap="innerHTML"
          class="mb-6 space-y-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
            <div class="space-y-2">
                <label for="search" class="block text-sm font-medium text-slate-700">Search</label>
                <input id="search"
                       name="search"
                       value="@Model.Search"
                       class="block h-11 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-950 outline-none transition focus:border-slate-950"
                       placeholder="Customer, vehicle, or plate"
                       oninput="clearTimeout(window.serviceFilterTimer); window.serviceFilterTimer = setTimeout(() => this.form.requestSubmit(), 250);" />
            </div>
            <div class="flex flex-wrap gap-2">
                <div>
                    <input id="status-all"
                           type="radio"
                           name="status"
                           value=""
                           class="peer sr-only"
                           onchange="this.form.requestSubmit()"
                           @(Model.Status is null ? "checked" : null) />
                    <label for="status-all" class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-400 peer-checked:border-slate-950 peer-checked:bg-slate-950 peer-checked:text-white">
                        All
                    </label>
                </div>
                @foreach (var count in Model.StatusCounts.Where(x => x.Status.HasValue))
                {
                    var id = $"status-{count.Status}";
                    <div>
                        <input id="@id"
                               type="radio"
                               name="status"
                               value="@count.Status"
                               class="peer sr-only"
                               onchange="this.form.requestSubmit()"
                               @(Model.Status == count.Status ? "checked" : null) />
                        <label for="@id" class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-400 peer-checked:border-slate-950 peer-checked:bg-slate-950 peer-checked:text-white">
                            @count.Label
                            <span class="ml-2 text-xs opacity-70">@count.Count</span>
                        </label>
                    </div>
                }
            </div>
        </div>
    </form>

    <div id="service-results">
        @await Html.PartialAsync("_ServiceResults", Model)
    </div>
</div>
