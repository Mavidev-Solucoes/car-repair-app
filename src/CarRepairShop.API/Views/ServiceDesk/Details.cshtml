@model ServiceDetailViewModel

@{
    ViewData["Title"] = "Service Detail";
}

<div class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
    <div class="mb-6">
        <div>
            <a href="/ui/services" class="text-sm text-slate-500 hover:text-slate-900">Back to services</a>
            <h1 class="mt-2 text-2xl font-semibold text-slate-950">@Model.CustomerName</h1>
            <p class="mt-1 text-sm text-slate-500">@Model.VehicleLabel · @Model.LicensePlate</p>
        </div>
    </div>

    @await Html.PartialAsync("_ServiceDetailContent", Model)
</div>
