@model ServiceCreateViewModel

@{
    ViewData["Title"] = "New Service";
}

<div class="mx-auto max-w-3xl px-6 py-8 lg:px-8">
    <div class="mb-8">
        <a href="/ui/services" class="text-sm text-slate-500 hover:text-slate-900">Back to services</a>
        <h1 class="mt-2 text-2xl font-semibold text-slate-950">New service</h1>
    </div>

    @if (Model.Flash is not null)
    {
        <div class="mb-6">
            @await Html.PartialAsync("_Flash", Model.Flash)
        </div>
    }

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        @if (!Model.CanCreate)
        {
            <p class="text-sm text-slate-500">You do not have permission to open services.</p>
        }
        else
        {
            <form method="post" class="space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>
                <div class="space-y-2">
                    <label asp-for="CustomerId" class="block text-sm font-medium text-slate-700">Customer</label>
                    <select asp-for="CustomerId"
                            hx-get="/ui/services/vehicle-options"
                            hx-target="#vehicle-select"
                            hx-swap="innerHTML"
                            hx-include="[name='VehicleId']"
                            hx-trigger="change"
                            class="block h-11 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-950 outline-none transition focus:border-slate-950">
                        <option value="">Select customer</option>
                        @foreach (var customer in Model.Customers)
                        {
                            <option value="@customer.Id">@customer.Label</option>
                        }
                    </select>
                    <span asp-validation-for="CustomerId" class="text-sm text-rose-600"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="VehicleId" class="block text-sm font-medium text-slate-700">Vehicle</label>
                    <select id="vehicle-select" asp-for="VehicleId" class="block h-11 w-full rounded-md border border-slate-300 px-3 text-sm text-slate-950 outline-none transition focus:border-slate-950">
                        @await Html.PartialAsync("_VehicleOptions", Model.Vehicles)
                    </select>
                    <span asp-validation-for="VehicleId" class="text-sm text-rose-600"></span>
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
                        Create service
                    </button>
                </div>
            </form>
        }
    </div>
</div>
