@model ServiceDetailViewModel

<div id="service-detail" class="space-y-8">
    @if (Model.Flash is not null)
    {
        @await Html.PartialAsync("_Flash", Model.Flash)
    }

    <section class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(20rem,0.6fr)]">
        <div class="space-y-6">
            <div class="grid gap-6 lg:grid-cols-3">
                <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                    <p class="text-xs uppercase tracking-[0.16em] text-slate-500">Status</p>
                    <div class="mt-3">@await Html.PartialAsync("_StatusBadge", Model.Status)</div>
                    <p class="mt-4 text-sm text-slate-500">Opened @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                    <p class="text-xs uppercase tracking-[0.16em] text-slate-500">Customer</p>
                    <p class="mt-3 text-base font-medium text-slate-950">
                        <a href="/ui/customers" class="hover:text-slate-700">@Model.CustomerName</a>
                    </p>
                    <p class="mt-2 text-sm text-slate-700">@Model.CustomerEmail</p>
                    <p class="mt-1 text-sm text-slate-500">@Model.CustomerTelephone</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                    <p class="text-xs uppercase tracking-[0.16em] text-slate-500">Vehicle / Assigned</p>
                    <p class="mt-3 text-base font-medium text-slate-950">
                        <a href="/ui/vehicles" class="hover:text-slate-700">@Model.VehicleLabel</a>
                    </p>
                    <p class="mt-2 text-sm text-slate-700">@Model.AssignedEmployee</p>
                </div>
            </div>

            <section class="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-200 px-5 py-4">
                    <h2 class="text-lg font-semibold text-slate-950">Items</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 text-sm">
                        <thead class="bg-slate-50 text-left text-slate-500">
                            <tr>
                                <th class="px-5 py-3 font-medium">Description</th>
                                <th class="px-5 py-3 font-medium text-right">Qty</th>
                                <th class="px-5 py-3 font-medium text-right">Unit</th>
                                <th class="px-5 py-3 font-medium text-right">Total</th>
                                <th class="px-5 py-3 font-medium text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 bg-white">
                            @if (Model.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="px-5 py-10 text-center text-slate-500">No service items recorded.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="px-5 py-3 text-slate-900">@item.Description</td>
                                        <td class="px-5 py-3 text-right text-slate-700">@item.Quantity</td>
                                        <td class="px-5 py-3 text-right text-slate-700">@item.Price.ToString("C")</td>
                                        <td class="px-5 py-3 text-right text-slate-900">@item.LineTotal.ToString("C")</td>
                                        <td class="px-5 py-3 text-right">
                                            @if (Model.CanModifyServiceItems)
                                            {
                                                <form method="post" action="/ui/services/@Model.Id/items/@item.Id/delete">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="text-sm text-slate-500 hover:text-slate-900">Remove</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.CanModifyServiceItems)
                {
                <div class="border-t border-slate-200 p-5">
                    <form method="post"
                          action="/ui/services/@Model.Id/items"
                          class="space-y-3">
                        @Html.AntiForgeryToken()
                        <p class="text-sm text-slate-500">Attach an existing catalog item to this service.</p>
                        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>
                        <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_7rem_auto]">
                            <div class="space-y-1">
                                <select asp-for="ItemForm.CatalogItemId" class="h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950">
                                    <option value="">Select catalog item</option>
                                    @foreach (var catalogItem in Model.CatalogItems)
                                    {
                                        <option value="@catalogItem.Id">@catalogItem.Name - @catalogItem.Price.ToString("C") - Stock @catalogItem.Stock</option>
                                    }
                                </select>
                                <span asp-validation-for="ItemForm.CatalogItemId" class="text-sm text-rose-600"></span>
                            </div>
                            <div class="space-y-1">
                                <input asp-for="ItemForm.Quantity" type="number" min="1" class="h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Qty" />
                                <span asp-validation-for="ItemForm.Quantity" class="text-sm text-rose-600"></span>
                            </div>
                            <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">Add item</button>
                        </div>
                    </form>
                </div>
                }
            </section>

            <section class="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-200 px-5 py-4">
                    <h2 class="text-lg font-semibold text-slate-950">Jobs</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 text-sm">
                        <thead class="bg-slate-50 text-left text-slate-500">
                            <tr>
                                <th class="px-5 py-3 font-medium">Job</th>
                                <th class="px-5 py-3 font-medium">Assigned</th>
                                <th class="px-5 py-3 font-medium">Status</th>
                                <th class="px-5 py-3 font-medium text-right">Labor</th>
                                <th class="px-5 py-3 font-medium text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 bg-white">
                            @if (Model.Jobs.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="px-5 py-10 text-center text-slate-500">No jobs recorded.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var job in Model.Jobs)
                                {
                                    <tr>
                                        <td class="px-5 py-3 align-top">
                                            <p class="font-medium text-slate-950">
                                                <a href="/ui/order-jobs/@job.Id" class="hover:text-slate-700">@job.Name</a>
                                            </p>
                                            <p class="mt-1 text-slate-500">@job.Description</p>
                                        </td>
                                        <td class="px-5 py-3 align-top text-slate-700">@job.AssignedEmployee</td>
                                        <td class="px-5 py-3 align-top">@await Html.PartialAsync("_JobStatusBadge", job.Status)</td>
                                        <td class="px-5 py-3 text-right align-top text-slate-900">@job.Price.ToString("C")</td>
                                        <td class="px-5 py-3 align-top">
                                            <div class="flex justify-end gap-2">
                                                @if (job.CanAcknowledge)
                                                {
                                                    <form
                                                        method="post"
                                                        hx-post="/ui/services/@Model.Id/jobs/@job.Id/acknowledge"
                                                        hx-target="#service-detail"
                                                        hx-swap="outerHTML">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="inline-flex h-9 items-center rounded-md border border-slate-300 px-3 text-xs font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                                                            Acknowledge
                                                        </button>
                                                    </form>
                                                }
                                                @if (job.CanStartProgress)
                                                {
                                                    <form
                                                        method="post"
                                                        hx-post="/ui/services/@Model.Id/jobs/@job.Id/start-progress"
                                                        hx-target="#service-detail"
                                                        hx-swap="outerHTML">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="inline-flex h-9 items-center rounded-md border border-slate-300 px-3 text-xs font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                                                            Start
                                                        </button>
                                                    </form>
                                                }
                                                @if (job.CanComplete)
                                                {
                                                    <form
                                                        method="post"
                                                        hx-post="/ui/services/@Model.Id/jobs/@job.Id/complete"
                                                        hx-target="#service-detail"
                                                        hx-swap="outerHTML">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="inline-flex h-9 items-center rounded-md border border-slate-300 px-3 text-xs font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                                                            Complete
                                                        </button>
                                                    </form>
                                                }
                                                @if (Model.CanModifyServiceItems && job.CanDelete)
                                                {
                                                    <form method="post" action="/ui/services/@Model.Id/jobs/@job.Id/delete">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="inline-flex h-9 items-center rounded-md border border-rose-200 px-3 text-xs font-semibold text-rose-700 transition hover:bg-rose-50">
                                                            Delete
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.CanModifyServiceItems)
                {
                <div class="border-t border-slate-200 p-5">
                    <form method="post" action="/ui/services/@Model.Id/jobs" class="space-y-3">
                        @Html.AntiForgeryToken()
                        <p class="text-sm text-slate-500">Attach an existing job from the job catalog.</p>
                        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>
                        <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto]">
                            <div class="space-y-1">
                                <select asp-for="JobForm.CatalogJobId" class="h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950">
                                    <option value="">Select job</option>
                                    @foreach (var catalogJob in Model.CatalogJobs)
                                    {
                                        <option value="@catalogJob.Id">@catalogJob.Name - @catalogJob.Price.ToString("C")</option>
                                    }
                                </select>
                                <span asp-validation-for="JobForm.CatalogJobId" class="text-sm text-rose-600"></span>
                            </div>
                            <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">Add job</button>
                        </div>
                    </form>
                </div>
                }
            </section>
        </div>

        <div class="space-y-6">
            <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="text-lg font-semibold text-slate-950">Summary</h2>
                <dl class="mt-5 space-y-3 text-sm">
                    <div class="flex items-center justify-between text-slate-500">
                        <dt>Parts total</dt>
                        <dd class="text-slate-900">@Model.PartsTotal.ToString("C")</dd>
                    </div>
                    <div class="flex items-center justify-between text-slate-500">
                        <dt>Labor total</dt>
                        <dd class="text-slate-900">@Model.LaborTotal.ToString("C")</dd>
                    </div>
                    <div class="flex items-center justify-between border-t border-slate-200 pt-3 text-base font-semibold text-slate-950">
                        <dt>Quoted total</dt>
                        <dd>@Model.GrandTotal.ToString("C")</dd>
                    </div>
                </dl>
            </section>

            <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm" x-data="{ confirmDispute: false }">
                <h2 class="text-lg font-semibold text-slate-950">Service Actions</h2>
                <div class="mt-5 grid gap-3">
                    @if (Model.CanRequestApproval)
                    {
                        <form method="post" hx-post="/ui/services/@Model.Id/request-approval" hx-target="#service-detail" hx-swap="outerHTML">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex h-11 w-full items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-semibold text-white transition hover:bg-slate-800">
                                Request approval
                            </button>
                        </form>
                    }
                    @if (Model.CanApprove)
                    {
                        <form method="post" hx-post="/ui/services/@Model.Id/approve" hx-target="#service-detail" hx-swap="outerHTML">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex h-11 w-full items-center justify-center rounded-md border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                                Simulate customer approval
                            </button>
                        </form>
                    }
                    @if (Model.CanDeliver)
                    {
                        <form method="post" hx-post="/ui/services/@Model.Id/deliver" hx-target="#service-detail" hx-swap="outerHTML">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex h-11 w-full items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-semibold text-white transition hover:bg-slate-800">
                                Mark delivered
                            </button>
                        </form>
                    }
                    @if (Model.CanDispute)
                    {
                        <div class="space-y-3">
                            <button type="button" x-on:click="confirmDispute = !confirmDispute" class="inline-flex h-11 w-full items-center justify-center rounded-md border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                                Return to diagnosing
                            </button>
                            <form x-show="confirmDispute" method="post" hx-post="/ui/services/@Model.Id/dispute" hx-target="#service-detail" hx-swap="outerHTML" class="space-y-2">
                                @Html.AntiForgeryToken()
                                <p class="text-xs text-slate-500">Reopen the service only when a finished job needs to go back to diagnosing.</p>
                                <button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                                    Confirm dispute
                                </button>
                            </form>
                        </div>
                    }
                    @if (!Model.CanRequestApproval && !Model.CanDeliver && !Model.CanDispute)
                    {
                        <p class="text-sm text-slate-500">No service-level actions are available in the current state.</p>
                    }
                </div>
            </section>

            <section class="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-200 px-5 py-4">
                    <h2 class="text-lg font-semibold text-slate-950">Status History</h2>
                </div>
                <ol class="space-y-0 px-5 py-3">
                    @foreach (var entry in Model.History)
                    {
                        <li class="flex items-start justify-between gap-4 border-b border-slate-100 py-3 last:border-b-0">
                            <div class="text-sm text-slate-900">@entry.Label</div>
                            <div class="text-xs uppercase tracking-[0.12em] text-slate-400">@entry.Timestamp</div>
                        </li>
                    }
                </ol>
            </section>
        </div>
    </section>
</div>
