@model JobStatus

@{
    var styles = Model switch
    {
        JobStatus.Open => "bg-slate-100 text-slate-700 ring-slate-200",
        JobStatus.Acknowledged => "bg-sky-50 text-sky-700 ring-sky-200",
        JobStatus.InProgress => "bg-amber-50 text-amber-700 ring-amber-200",
        JobStatus.Completed => "bg-emerald-50 text-emerald-700 ring-emerald-200",
        _ => "bg-white text-slate-700 ring-slate-200"
    };
}

<span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset @styles">
    @Model
</span>
