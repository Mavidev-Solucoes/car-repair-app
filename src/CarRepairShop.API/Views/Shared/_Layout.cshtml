<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Car Repair Shop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
    <div class="min-h-screen">
        @if (User.Identity?.IsAuthenticated == true)
        {
            var path = Context.Request.Path.Value ?? string.Empty;
            var isCustomer = User.IsInRole("Customer");
            var isMechanic = User.IsInRole("Mechanic");
            var isAdmin = User.IsInRole("Admin");
            var navItems = isCustomer
                ? new[]
                {
                    new { Href = "/ui/services", Label = "My Services", AdminOnly = false }
                }
                : isMechanic
                    ? new[]
                    {
                        new { Href = "/ui/order-jobs", Label = "Order Jobs", AdminOnly = false }
                    }
                    : new[]
                    {
                        new { Href = "/ui/services", Label = "Services", AdminOnly = false },
                        new { Href = "/ui/order-jobs", Label = "Order Jobs", AdminOnly = false },
                        new { Href = "/ui/service-jobs", Label = "Job Catalog", AdminOnly = false },
                        new { Href = "/ui/customers", Label = "Customers", AdminOnly = false },
                        new { Href = "/ui/vehicles", Label = "Vehicles", AdminOnly = false },
                        new { Href = "/ui/catalog", Label = "Catalog", AdminOnly = false },
                        new { Href = "/ui/users", Label = "Users", AdminOnly = true }
                    };

            <header class="border-b border-slate-200 bg-white">
                <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4 lg:px-8">
                    <div class="flex items-center gap-8">
                        <a href="/ui/services" class="text-base font-semibold text-slate-950">Car Repair Shop</a>
                        <nav class="flex items-center gap-2">
                            @foreach (var item in navItems)
                            {
                                if (item.AdminOnly && !isAdmin)
                                {
                                    continue;
                                }

                                var active = path.StartsWith(item.Href, StringComparison.OrdinalIgnoreCase);
                                <a href="@item.Href" class="rounded-md px-3 py-2 text-sm font-medium transition @(active ? "bg-slate-900 text-white" : "text-slate-600 hover:bg-slate-100 hover:text-slate-950")">
                                    @item.Label
                                </a>
                            }
                        </nav>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="text-right">
                            <p class="text-sm font-medium text-slate-900">@User.Identity?.Name</p>
                            <p class="text-xs text-slate-500">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                        </div>
                        <a href="/ui/password" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                            Password
                        </a>
                        <form method="post" action="/ui/logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                                Sign out
                            </button>
                        </form>
                    </div>
                </div>
            </header>
        }

        <main>
            @RenderBody()
        </main>
    </div>
</body>
</html>
