@model ServiceStatus

@{
    var styles = Model switch
    {
        ServiceStatus.Received => "bg-sky-50 text-sky-700 ring-sky-200",
        ServiceStatus.Diagnosing => "bg-amber-50 text-amber-700 ring-amber-200",
        ServiceStatus.WaitingForApproval => "bg-fuchsia-50 text-fuchsia-700 ring-fuchsia-200",
        ServiceStatus.Executing => "bg-orange-50 text-orange-700 ring-orange-200",
        ServiceStatus.Finished => "bg-emerald-50 text-emerald-700 ring-emerald-200",
        ServiceStatus.Delivered => "bg-slate-100 text-slate-700 ring-slate-200",
        _ => "bg-white text-slate-700 ring-slate-200"
    };
}

<span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset @styles">
    @Model
</span>
