@model ServiceJobsPageViewModel

@{
    ViewData["Title"] = "Service Jobs";
}

<div x-data="{ detailModalOpen: false }" class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-950">Service Jobs</h1>
        <p class="mt-1 text-sm text-slate-500">Reusable labor entries for service orders.</p>
    </div>

    @if (Model.Flash is not null)
    {
        <div class="mb-6">
            @await Html.PartialAsync("_Flash", Model.Flash)
        </div>
    }

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_24rem]">
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <form method="get" action="/ui/service-jobs" class="flex gap-3 border-b border-slate-200 bg-slate-50 px-5 py-4">
                <input name="Filters.Name" value="@Model.Search" class="h-10 min-w-0 flex-1 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Job name" />
                <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">Filter</button>
            </form>
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-left text-slate-500">
                    <tr>
                        <th class="px-5 py-3 font-medium">Job</th>
                        <th class="px-5 py-3 font-medium text-right">Price</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var job in Model.Jobs)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-4">
                                <button type="button"
                                        class="font-medium text-slate-950 hover:text-slate-700"
                                        x-on:click="detailModalOpen = true"
                                        hx-get="/ui/service-jobs/@job.Id/details"
                                        hx-target="#service-job-detail-modal-content"
                                        hx-swap="innerHTML">
                                    @job.Name
                                </button>
                                <div class="mt-1 text-slate-500">@job.Description</div>
                            </td>
                            <td class="px-5 py-4 text-right text-slate-900">@job.Price.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-6">
                <h2 class="text-lg font-semibold text-slate-950">New job</h2>
            </div>

            <form method="post" action="/ui/service-jobs/save" class="space-y-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-sm text-rose-600"></div>
                <div class="space-y-2">
                    <label asp-for="Form.Name" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Form.Name" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.Name" class="text-sm text-rose-600"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="Form.Description" class="block text-sm font-medium text-slate-700"></label>
                    <textarea asp-for="Form.Description" rows="4" class="block w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-slate-950"></textarea>
                    <span asp-validation-for="Form.Description" class="text-sm text-rose-600"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="Form.Price" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Form.Price" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.Price" class="text-sm text-rose-600"></span>
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
                        Create job
                    </button>
                </div>
            </form>
        </section>
    </div>

    <div x-cloak
         x-show="detailModalOpen"
         x-on:keydown.escape.window="detailModalOpen = false"
         class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-950/45" x-on:click="detailModalOpen = false"></div>
        <div class="relative z-10 w-full max-w-2xl rounded-xl border border-slate-200 bg-white p-6 shadow-2xl">
            <div id="service-job-detail-modal-content"></div>
        </div>
    </div>
</div>
