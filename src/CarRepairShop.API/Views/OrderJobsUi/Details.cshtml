@model ServiceJobDetailViewModel

@{
    ViewData["Title"] = "Order Job";
}

<div class="mx-auto max-w-5xl px-6 py-8 lg:px-8">
    <div class="mb-6">
        <a href="/ui/order-jobs" class="text-sm text-slate-500 hover:text-slate-900">Back to order jobs</a>
        <h1 class="mt-2 text-2xl font-semibold text-slate-950">@Model.Form.Name</h1>
        <p class="mt-1 text-sm text-slate-500">@Model.Form.Description</p>
    </div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
        <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <dl class="space-y-3 text-sm">
                <div class="flex items-center justify-between">
                    <dt class="text-slate-500">Assigned</dt>
                    <dd class="text-slate-900">@Model.AssignedEmployee</dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-slate-500">Price</dt>
                    <dd class="text-slate-900">@Model.Form.Price.ToString("C")</dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-slate-500">Status</dt>
                    <dd>@await Html.PartialAsync("_JobStatusBadge", Model.Status)</dd>
                </div>
            </dl>
        </section>

        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-semibold text-slate-950">Actions</h2>
            <div class="mt-5 grid gap-3">
                @if (Model.CanAcknowledge)
                {
                    <form method="post" action="/ui/order-jobs/@Model.Id/acknowledge">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex h-11 w-full items-center justify-center rounded-md border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                            Acknowledge
                        </button>
                    </form>
                }
                @if (Model.CanStartProgress)
                {
                    <form method="post" action="/ui/order-jobs/@Model.Id/start-progress">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex h-11 w-full items-center justify-center rounded-md border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                            Start progress
                        </button>
                    </form>
                }
                @if (Model.CanComplete)
                {
                    <form method="post" action="/ui/order-jobs/@Model.Id/complete">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex h-11 w-full items-center justify-center rounded-md bg-slate-950 px-4 text-sm font-semibold text-white transition hover:bg-slate-800">
                            Complete
                        </button>
                    </form>
                }
            </div>
        </section>
    </div>
</div>
