@model ServiceJobsPageViewModel

@{
    ViewData["Title"] = "Order Jobs";
}

<div class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-950">Order Jobs</h1>
        <p class="mt-1 text-sm text-slate-500">Execution board for mechanics.</p>
    </div>

    <form method="get" class="mb-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:grid-cols-[minmax(0,1fr)_14rem_auto] md:items-end">
        <div class="space-y-2">
            <label for="search" class="block text-sm font-medium text-slate-700">Search</label>
            <input id="search" name="search" value="@Model.Search" class="block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Job name" />
        </div>
        <div class="space-y-2">
            <label for="status" class="block text-sm font-medium text-slate-700">Status</label>
            <select id="status" name="status" class="block h-11 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<JobStatus>())
                {
                    <option value="@status" selected="@(Model.Status == status)">@status</option>
                }
            </select>
        </div>
        <div class="flex gap-2">
            <button type="submit" class="inline-flex h-11 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
                Filter
            </button>
            <a href="/ui/order-jobs" class="inline-flex h-11 items-center rounded-md border border-slate-300 px-4 text-sm font-medium text-slate-700 transition hover:border-slate-400 hover:bg-slate-100">
                Clear
            </a>
        </div>
    </form>

    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-left text-slate-500">
                <tr>
                    <th class="px-5 py-3 font-medium">Job</th>
                    <th class="px-5 py-3 font-medium">Assigned</th>
                    <th class="px-5 py-3 font-medium text-right">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
                @foreach (var job in Model.Jobs)
                {
                    <tr class="hover:bg-slate-50">
                        <td class="px-5 py-4">
                            <a href="/ui/order-jobs/@job.Id" class="font-medium text-slate-950">@job.Name</a>
                            <div class="mt-1 text-slate-500">@job.Description</div>
                        </td>
                        <td class="px-5 py-4 text-slate-700">@job.AssignedEmployee</td>
                        <td class="px-5 py-4 text-right">@await Html.PartialAsync("_JobStatusBadge", job.Status)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>
