@model CustomersPageViewModel

@{
    ViewData["Title"] = "Customers";
}

<div x-data="{ detailModalOpen: false }" class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-950">Customers</h1>
        <p class="mt-1 text-sm text-slate-500">Create, update, and review customer records.</p>
    </div>

    @if (Model.Flash is not null)
    {
        <div class="mb-6">
            @await Html.PartialAsync("_Flash", Model.Flash)
        </div>
    }

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_24rem]">
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <form method="get" action="/ui/customers" class="grid gap-3 border-b border-slate-200 bg-slate-50 px-5 py-4 md:grid-cols-4">
                <input asp-for="Filters.Name" class="h-10 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Name" />
                <input asp-for="Filters.Email" class="h-10 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Email" />
                <input asp-for="Filters.PersonalId" class="h-10 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Personal ID" />
                <div class="flex gap-3">
                    <input asp-for="Filters.Telephone" class="h-10 min-w-0 flex-1 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Telephone" />
                    <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">Filter</button>
                </div>
            </form>
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-left text-slate-500">
                    <tr>
                        <th class="px-5 py-3 font-medium">Customer</th>
                        <th class="px-5 py-3 font-medium">Contact</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var customer in Model.Customers)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-4">
                                <button type="button"
                                        class="font-medium text-slate-950 hover:text-slate-700"
                                        x-on:click="detailModalOpen = true"
                                        hx-get="/ui/customers/@customer.Id/details"
                                        hx-target="#customer-detail-modal-content"
                                        hx-swap="innerHTML">
                                    @customer.Name
                                </button>
                                <div class="mt-1 text-slate-500">@customer.PersonalId</div>
                            </td>
                            <td class="px-5 py-4 text-slate-700">
                                <div>@customer.Email</div>
                                <div class="mt-1 text-slate-500">@customer.Telephone</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-6">
                <h2 class="text-lg font-semibold text-slate-950">New customer</h2>
            </div>

            <form method="post" action="/ui/customers/save" class="space-y-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-sm text-rose-600"></div>
                <div class="space-y-2">
                    <label asp-for="Form.Name" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Form.Name" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.Name" class="text-sm text-rose-600"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="Form.PersonalId" class="block text-sm font-medium text-slate-700">Personal ID</label>
                    <input asp-for="Form.PersonalId" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.PersonalId" class="text-sm text-rose-600"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="Form.Email" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Form.Email" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.Email" class="text-sm text-rose-600"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="Form.Telephone" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Form.Telephone" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.Telephone" class="text-sm text-rose-600"></span>
                </div>
                <div class="flex justify-end pt-2">
                    <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
                        Create customer
                    </button>
                </div>
            </form>
        </section>
    </div>

    <div x-cloak
         x-show="detailModalOpen"
         x-on:keydown.escape.window="detailModalOpen = false"
         class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-950/45" x-on:click="detailModalOpen = false"></div>
        <div class="relative z-10 w-full max-w-3xl rounded-xl border border-slate-200 bg-white p-6 shadow-2xl">
            <div id="customer-detail-modal-content">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-950">Customer</h3>
                        <p class="mt-1 text-sm text-slate-500">Loading details…</p>
                    </div>
                    <button type="button"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
                            x-on:click="detailModalOpen = false">
                        <span class="sr-only">Close</span>
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
