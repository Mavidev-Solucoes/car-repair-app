@model CustomerDetailsModalViewModel

<div class="flex items-start justify-between gap-4">
    <div>
        <h3 class="text-lg font-semibold text-slate-950">@Model.Form.Name</h3>
        <p class="mt-1 text-sm text-slate-500">@Model.Form.PersonalId</p>
    </div>
    <button type="button"
            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
            x-on:click="detailModalOpen = false">
        <span class="sr-only">Close</span>
        <span aria-hidden="true">×</span>
    </button>
</div>

<form method="post"
      action="/ui/customers/@Model.Form.Id/update"
      hx-post="/ui/customers/@Model.Form.Id/update"
      hx-target="#customer-detail-modal-content"
      hx-swap="innerHTML"
      class="mt-5 space-y-4">
    @Html.AntiForgeryToken()
    <input asp-for="Form.Id" type="hidden" />
    <div asp-validation-summary="All" class="text-sm text-rose-600"></div>

    <div class="space-y-2">
        <label asp-for="Form.Name" class="block text-sm font-medium text-slate-700"></label>
        <input asp-for="Form.Name" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
        <span asp-validation-for="Form.Name" class="text-sm text-rose-600"></span>
    </div>
    <div class="space-y-2">
        <label class="block text-sm font-medium text-slate-700">Personal ID</label>
        <input asp-for="Form.PersonalId" readonly class="block h-10 w-full rounded-md border border-slate-300 bg-slate-50 px-3 text-sm text-slate-500 outline-none" />
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
            <label asp-for="Form.Email" class="block text-sm font-medium text-slate-700"></label>
            <input asp-for="Form.Email" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
            <span asp-validation-for="Form.Email" class="text-sm text-rose-600"></span>
        </div>
        <div class="space-y-2">
            <label asp-for="Form.Telephone" class="block text-sm font-medium text-slate-700"></label>
            <input asp-for="Form.Telephone" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
            <span asp-validation-for="Form.Telephone" class="text-sm text-rose-600"></span>
        </div>
    </div>

    <div>
        <h4 class="text-sm font-semibold text-slate-950">Vehicles</h4>
        <div class="mt-3 overflow-hidden rounded-lg border border-slate-200">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-left text-slate-500">
                    <tr>
                        <th class="px-4 py-3 font-medium">Vehicle</th>
                        <th class="px-4 py-3 font-medium text-right">Plate</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                    @if (Model.Vehicles.Count == 0)
                    {
                        <tr>
                            <td colspan="2" class="px-4 py-8 text-center text-slate-500">No vehicles registered for this customer.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var vehicle in Model.Vehicles)
                        {
                            <tr>
                                <td class="px-4 py-3 text-slate-900">
                                    <a href="/ui/vehicles" class="font-medium text-slate-950">@vehicle.Brand @vehicle.Model</a>
                                    <div class="mt-1 text-slate-500">@vehicle.Year @if (!string.IsNullOrWhiteSpace(vehicle.Color)) { <text>· @vehicle.Color</text> }</div>
                                </td>
                                <td class="px-4 py-3 text-right text-slate-900">@vehicle.LicensePlate</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="flex items-center justify-between gap-3">
        <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
            Save changes
        </button>
        @if (Model.CanDelete)
        {
            <span class="ml-auto">
                <button type="submit"
                        form="delete-customer-@Model.Form.Id"
                        class="inline-flex h-10 items-center rounded-md bg-rose-600 px-4 text-sm font-medium text-white transition hover:bg-rose-700">
                    Delete customer
                </button>
            </span>
        }
    </div>
</form>

@if (Model.CanDelete)
{
    <form id="delete-customer-@Model.Form.Id" method="post" action="/ui/customers/@Model.Form.Id/delete" class="hidden">
        @Html.AntiForgeryToken()
    </form>
}
