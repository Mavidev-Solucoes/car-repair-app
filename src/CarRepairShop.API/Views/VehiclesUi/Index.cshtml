@model VehiclesPageViewModel

@{
    ViewData["Title"] = "Vehicles";
}

<div x-data="{ detailModalOpen: false }" class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-950">Vehicles</h1>
        <p class="mt-1 text-sm text-slate-500">Register vehicles and keep them tied to customers.</p>
    </div>

    @if (Model.Flash is not null)
    {
        <div class="mb-6">
            @await Html.PartialAsync("_Flash", Model.Flash)
        </div>
    }

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_24rem]">
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <form method="get" action="/ui/vehicles" class="grid gap-3 border-b border-slate-200 bg-slate-50 px-5 py-4 md:grid-cols-4">
                <input asp-for="Filters.Brand" class="h-10 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Brand" />
                <input asp-for="Filters.Model" class="h-10 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Model" />
                <input asp-for="Filters.Year" class="h-10 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Year" />
                <div class="flex gap-3">
                    <input asp-for="Filters.LicensePlate" class="h-10 min-w-0 flex-1 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="License plate" />
                    <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">Filter</button>
                </div>
            </form>
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-left text-slate-500">
                    <tr>
                        <th class="px-5 py-3 font-medium">Vehicle</th>
                        <th class="px-5 py-3 font-medium">Customer</th>
                        <th class="px-5 py-3 font-medium text-right">Plate</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var vehicle in Model.Vehicles)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-4">
                                <button type="button"
                                        class="font-medium text-slate-950 hover:text-slate-700"
                                        x-on:click="detailModalOpen = true"
                                        hx-get="/ui/vehicles/@vehicle.Id/details"
                                        hx-target="#vehicle-detail-modal-content"
                                        hx-swap="innerHTML">
                                    @vehicle.Brand @vehicle.Model
                                </button>
                                <div class="mt-1 text-slate-500">@vehicle.Year @if (!string.IsNullOrWhiteSpace(vehicle.Color)) { <text>· @vehicle.Color</text> }</div>
                            </td>
                            <td class="px-5 py-4 text-slate-700">@vehicle.CustomerName</td>
                            <td class="px-5 py-4 text-right text-slate-900">@vehicle.LicensePlate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-6">
                <h2 class="text-lg font-semibold text-slate-950">New vehicle</h2>
            </div>

            <form method="post" action="/ui/vehicles/save" class="space-y-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-sm text-rose-600"></div>
                <div class="space-y-2">
                    <label asp-for="Form.CustomerId" class="block text-sm font-medium text-slate-700">Customer</label>
                    <select asp-for="Form.CustomerId" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950">
                        <option value="">Select customer</option>
                        @foreach (var customer in Model.Customers)
                        {
                            <option value="@customer.Id">@customer.Label</option>
                        }
                    </select>
                    <span asp-validation-for="Form.CustomerId" class="text-sm text-rose-600"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="Form.Brand" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Form.Brand" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.Brand" class="text-sm text-rose-600"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="Form.Model" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Form.Model" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.Model" class="text-sm text-rose-600"></span>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="space-y-2">
                        <label asp-for="Form.Year" class="block text-sm font-medium text-slate-700"></label>
                        <input asp-for="Form.Year" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                        <span asp-validation-for="Form.Year" class="text-sm text-rose-600"></span>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="Form.Color" class="block text-sm font-medium text-slate-700"></label>
                        <input asp-for="Form.Color" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                        <span asp-validation-for="Form.Color" class="text-sm text-rose-600"></span>
                    </div>
                </div>
                <div class="space-y-2">
                    <label asp-for="Form.LicensePlate" class="block text-sm font-medium text-slate-700">License plate</label>
                    <input asp-for="Form.LicensePlate" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.LicensePlate" class="text-sm text-rose-600"></span>
                </div>
                <div class="flex justify-end pt-2">
                    <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
                        Create vehicle
                    </button>
                </div>
            </form>
        </section>
    </div>

    <div x-cloak
         x-show="detailModalOpen"
         x-on:keydown.escape.window="detailModalOpen = false"
         class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-950/45" x-on:click="detailModalOpen = false"></div>
        <div class="relative z-10 w-full max-w-2xl rounded-xl border border-slate-200 bg-white p-6 shadow-2xl">
            <div id="vehicle-detail-modal-content">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-950">Vehicle</h3>
                        <p class="mt-1 text-sm text-slate-500">Loading details…</p>
                    </div>
                    <button type="button"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
                            x-on:click="detailModalOpen = false">
                        <span class="sr-only">Close</span>
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
