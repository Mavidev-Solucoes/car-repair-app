@using CarRepairShop.Domain.Enums
@model UserDetailsModalViewModel

<div class="flex items-start justify-between gap-4">
    <div>
        <h3 class="text-lg font-semibold text-slate-950">@Model.Form.Name</h3>
        <p class="mt-1 text-sm text-slate-500">@Model.Form.Email</p>
    </div>
    <button type="button"
            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
            x-on:click="detailModalOpen = false">
        <span class="sr-only">Close</span>
        <span aria-hidden="true">×</span>
    </button>
</div>

<div class="mt-5 flex items-center gap-3">
    <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @(Model.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600")">
        @(Model.IsActive ? "Active" : "Inactive")
    </span>
</div>

<form method="post"
      action="/ui/users/@Model.Form.Id/update"
      hx-post="/ui/users/@Model.Form.Id/update"
      hx-target="#user-detail-modal-content"
      hx-swap="innerHTML"
      class="mt-5 space-y-4">
    @Html.AntiForgeryToken()
    <input asp-for="Form.Id" type="hidden" />
    <div asp-validation-summary="All" class="text-sm text-rose-600"></div>

    <div class="space-y-2">
        <label asp-for="Form.Name" class="block text-sm font-medium text-slate-700"></label>
        <input asp-for="Form.Name" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
        <span asp-validation-for="Form.Name" class="text-sm text-rose-600"></span>
    </div>
    <div class="space-y-2">
        <label asp-for="Form.Email" class="block text-sm font-medium text-slate-700"></label>
        <input asp-for="Form.Email" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
        <span asp-validation-for="Form.Email" class="text-sm text-rose-600"></span>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-2">
            <label asp-for="Form.Role" class="block text-sm font-medium text-slate-700"></label>
            <select asp-for="Form.Role" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950">
                @foreach (var role in Enum.GetValues<UserRole>().Cast<UserRole>().Where(role => role != UserRole.Customer))
                {
                    <option value="@role">@role</option>
                }
            </select>
            <span asp-validation-for="Form.Role" class="text-sm text-rose-600"></span>
        </div>
    </div>

    <div class="flex items-center justify-between gap-3">
        <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
            Save changes
        </button>
        @if (Model.CanDeactivate)
        {
            <span class="ml-auto">
                <button type="submit"
                        form="deactivate-user-@Model.Form.Id"
                        class="inline-flex h-10 items-center rounded-md bg-rose-600 px-4 text-sm font-medium text-white transition hover:bg-rose-700">
                    Deactivate user
                </button>
            </span>
        }
        else
        {
            <span class="ml-auto">
                <button type="submit"
                        form="activate-user-@Model.Form.Id"
                        class="inline-flex h-10 items-center rounded-md bg-emerald-600 px-4 text-sm font-medium text-white transition hover:bg-emerald-700">
                    Activate user
                </button>
            </span>
        }
    </div>
</form>

<form id="deactivate-user-@Model.Form.Id" method="post" action="/ui/users/@Model.Form.Id/deactivate" class="hidden">
    @Html.AntiForgeryToken()
</form>

<form id="activate-user-@Model.Form.Id" method="post" action="/ui/users/@Model.Form.Id/activate" class="hidden">
    @Html.AntiForgeryToken()
</form>
