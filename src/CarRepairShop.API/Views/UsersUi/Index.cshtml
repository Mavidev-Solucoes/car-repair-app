@model UsersPageViewModel

@{
    ViewData["Title"] = "Users";
}

<div x-data="{ detailModalOpen: false }" class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-950">Users</h1>
        <p class="mt-1 text-sm text-slate-500">Create and manage employee accounts.</p>
    </div>

    @if (Model.Flash is not null)
    {
        <div class="mb-6">
            @await Html.PartialAsync("_Flash", Model.Flash)
        </div>
    }

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_24rem]">
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <form method="get" action="/ui/users" class="grid gap-3 border-b border-slate-200 bg-slate-50 px-5 py-4 md:grid-cols-[minmax(0,1.5fr)_1fr_1fr_auto]">
                <input asp-for="Filters.Search" class="h-10 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" placeholder="Name or email" />
                <select asp-for="Filters.Role" class="h-10 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950">
                    <option value="">All roles</option>
                    @foreach (var role in Enum.GetValues<UserRole>().Cast<UserRole>().Where(role => role != UserRole.Customer))
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <div class="flex gap-3">
                    <select asp-for="Filters.IsActive" class="h-10 min-w-0 flex-1 rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950">
                        <option value="">Any state</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">Filter</button>
                </div>
            </form>
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-left text-slate-500">
                    <tr>
                        <th class="px-5 py-3 font-medium">User</th>
                        <th class="px-5 py-3 font-medium">Role</th>
                        <th class="px-5 py-3 font-medium text-right">State</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var user in Model.Users)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-4">
                                <button type="button"
                                        class="font-medium text-slate-950 hover:text-slate-700"
                                        x-on:click="detailModalOpen = true"
                                        hx-get="/ui/users/@user.Id/details"
                                        hx-target="#user-detail-modal-content"
                                        hx-swap="innerHTML">
                                    @user.Name
                                </button>
                                <div class="mt-1 text-slate-500">@user.Email</div>
                            </td>
                            <td class="px-5 py-4 text-slate-700">@user.Role</td>
                            <td class="px-5 py-4 text-right">
                                <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @(user.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-6">
                <h2 class="text-lg font-semibold text-slate-950">New user</h2>
            </div>

            <form method="post" action="/ui/users/save" class="space-y-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-sm text-rose-600"></div>
                <div class="space-y-2">
                    <label asp-for="Form.Name" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Form.Name" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.Name" class="text-sm text-rose-600"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="Form.Email" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Form.Email" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.Email" class="text-sm text-rose-600"></span>
                </div>
                <div class="space-y-2">
                    <label asp-for="Form.Password" class="block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Form.Password" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950" />
                    <span asp-validation-for="Form.Password" class="text-sm text-rose-600"></span>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="space-y-2">
                        <label asp-for="Form.Role" class="block text-sm font-medium text-slate-700"></label>
                        <select asp-for="Form.Role" class="block h-10 w-full rounded-md border border-slate-300 px-3 text-sm outline-none transition focus:border-slate-950">
                            @foreach (var role in Enum.GetValues<UserRole>().Cast<UserRole>().Where(role => role != UserRole.Customer))
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <span asp-validation-for="Form.Role" class="text-sm text-rose-600"></span>
                    </div>
                </div>
                <div class="flex justify-end pt-2">
                    <button type="submit" class="inline-flex h-10 items-center rounded-md bg-slate-950 px-4 text-sm font-medium text-white transition hover:bg-slate-800">
                        Create user
                    </button>
                </div>
            </form>
        </section>
    </div>

    <div x-cloak
         x-show="detailModalOpen"
         x-on:keydown.escape.window="detailModalOpen = false"
         class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-slate-950/45" x-on:click="detailModalOpen = false"></div>
        <div class="relative z-10 w-full max-w-2xl rounded-xl border border-slate-200 bg-white p-6 shadow-2xl">
            <div id="user-detail-modal-content">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-950">User</h3>
                        <p class="mt-1 text-sm text-slate-500">Loading details…</p>
                    </div>
                    <button type="button"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
                            x-on:click="detailModalOpen = false">
                        <span class="sr-only">Close</span>
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
